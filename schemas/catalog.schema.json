{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/jmlero/agent-suitup/main/schemas/catalog.schema.json",
  "title": "agent-suitup catalog",
  "type": "object",
  "required": ["catalogVersion", "components"],
  "properties": {
    "$schema": { "type": "string" },
    "catalogVersion": { "const": 2 },
    "components": {
      "type": "array",
      "items": { "$ref": "#/$defs/component" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "component": {
      "type": "object",
      "required": ["id", "version", "kind", "name", "category", "description", "scopes"],
      "properties": {
        "id": { "type": "string", "pattern": "^(block|skill|command|plugin)/[a-z0-9][a-z0-9-]*$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "kind": { "enum": ["block", "skill", "command", "plugin"] },
        "name": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "selection": {
          "type": "object",
          "required": ["when", "consider", "example"],
          "properties": {
            "when": { "type": "string", "minLength": 1 },
            "consider": { "type": "string", "minLength": 1 },
            "example": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "outcome": { "type": "string", "minLength": 1 },
        "alwaysOnJustification": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "lastVerified": { "type": "string", "format": "date" },
        "adapters": {
          "type": "array",
          "items": { "enum": ["claude", "grok"] },
          "minItems": 1,
          "uniqueItems": true
        },
        "scopes": {
          "type": "array",
          "items": { "enum": ["project", "user"] },
          "minItems": 1,
          "uniqueItems": true
        },
        "recommendedScope": { "enum": ["project", "user"] },
        "context": { "$ref": "#/$defs/context" },
        "content": { "$ref": "#/$defs/content" },
        "suggest": { "$ref": "#/$defs/suggest" },
        "requires": { "$ref": "#/$defs/requires" },
        "adapter": { "$ref": "#/$defs/adapter" },
        "conflictsWith": {
          "type": "array",
          "items": { "type": "string", "pattern": "^(block|skill|command|plugin)/" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "block" } }, "required": ["kind"] },
          "then": {
            "required": ["content", "context", "outcome", "alwaysOnJustification"],
            "properties": {
              "scopes": { "const": ["project"] },
              "context": {
                "properties": { "loading": { "const": "always" } },
                "required": ["loading"]
              }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "enum": ["skill", "command"] } }, "required": ["kind"] },
          "then": { "required": ["content", "context"] }
        },
        {
          "if": { "properties": { "kind": { "const": "plugin" } }, "required": ["kind"] },
          "then": { "required": ["adapters"] }
        },
        {
          "if": { "properties": { "kind": { "const": "plugin" } }, "required": ["kind"] },
          "then": {
            "required": ["adapter", "lastVerified"],
            "properties": {
              "content": false,
              "context": false
            }
          },
          "else": {
            "properties": {
              "adapter": false,
              "lastVerified": false
            }
          }
        }
      ]
    },
    "context": {
      "type": "object",
      "required": ["loading"],
      "properties": {
        "loading": { "enum": ["always", "on-demand", "explicit", "none"] },
        "estimatedTokens": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "content": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "path"],
          "properties": {
            "kind": { "const": "bundled" },
            "path": { "type": "string", "minLength": 1 },
            "root": { "type": "string", "minLength": 1 },
            "upstream": { "type": "string", "minLength": 1 },
            "revision": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "url", "upstream"],
          "properties": {
            "kind": { "const": "remote" },
            "url": { "type": "string", "format": "uri" },
            "upstream": { "type": "string", "minLength": 1 },
            "mutable": { "type": "boolean" },
            "root": { "type": "string", "minLength": 1 },
            "overlay": { "type": "string", "minLength": 1 },
            "licensePath": { "type": "string", "minLength": 1 },
            "licenseTarget": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      ]
    },
    "suggest": {
      "type": "object",
      "required": ["when", "reason"],
      "properties": {
        "when": {
          "type": "object",
          "properties": {
            "all": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
            "any": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true }
          },
          "additionalProperties": false,
          "anyOf": [{ "required": ["all"] }, { "required": ["any"] }]
        },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "requires": {
      "type": "object",
      "required": ["commands"],
      "properties": {
        "commands": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-zA-Z0-9._-]+$" },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "adapter": {
      "type": "object",
      "required": ["claude"],
      "properties": {
        "claude": {
          "type": "object",
          "required": ["pluginId", "marketplace"],
          "properties": {
            "pluginId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
            "marketplace": {
              "type": "object",
              "required": ["name", "repo"],
              "properties": {
                "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
                "repo": { "type": "string", "pattern": "^[^/]+/[^/]+$" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
