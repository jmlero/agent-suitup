{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/jmlero/agent-suitup/main/schemas/catalog.schema.json",
  "title": "agent-suitup catalog",
  "type": "object",
  "required": ["catalogVersion", "components"],
  "properties": {
    "$schema": { "type": "string" },
    "catalogVersion": { "const": 2 },
    "components": { "type": "array", "items": { "$ref": "#/$defs/component" } }
  },
  "additionalProperties": false,
  "$defs": {
    "component": {
      "type": "object",
      "required": ["id", "version", "kind", "name", "category", "description", "scopes"],
      "properties": {
        "id": { "type": "string", "pattern": "^(block|skill|command|plugin)/[a-z0-9][a-z0-9-]*$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "kind": { "enum": ["block", "skill", "command", "plugin"] },
        "name": { "type": "string", "pattern": "\\S" },
        "category": { "type": "string", "pattern": "\\S" },
        "description": { "type": "string", "pattern": "\\S" },
        "selection": {
          "type": "object",
          "required": ["when", "consider", "example"],
          "properties": {
            "when": { "type": "string", "pattern": "\\S" },
            "consider": { "type": "string", "pattern": "\\S" },
            "example": { "type": "string", "pattern": "\\S" }
          },
          "additionalProperties": false
        },
        "outcome": { "type": "string", "pattern": "\\S" },
        "alwaysOnJustification": { "type": "string", "pattern": "\\S" },
        "license": { "type": "string", "pattern": "\\S" },
        "lastVerified": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "format": "date"
        },
        "adapters": {
          "type": "array",
          "items": { "enum": ["claude", "grok"] },
          "minItems": 1,
          "uniqueItems": true
        },
        "scopes": {
          "type": "array",
          "items": { "enum": ["project", "user"] },
          "minItems": 1,
          "uniqueItems": true
        },
        "recommendedScope": { "enum": ["project", "user"] },
        "context": { "$ref": "#/$defs/context" },
        "content": { "$ref": "#/$defs/content" },
        "suggest": { "$ref": "#/$defs/suggest" },
        "requires": { "$ref": "#/$defs/requires" },
        "adapter": { "$ref": "#/$defs/adapter" },
        "conflictsWith": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(block|skill|command|plugin)/[a-z0-9][a-z0-9-]*$"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "block" } }, "required": ["kind"] },
          "then": { "properties": { "id": { "pattern": "^block/" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "skill" } }, "required": ["kind"] },
          "then": { "properties": { "id": { "pattern": "^skill/" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "command" } }, "required": ["kind"] },
          "then": { "properties": { "id": { "pattern": "^command/" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "plugin" } }, "required": ["kind"] },
          "then": { "properties": { "id": { "pattern": "^plugin/" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "block" } }, "required": ["kind"] },
          "then": {
            "required": ["content", "context", "outcome", "alwaysOnJustification"],
            "properties": {
              "scopes": { "const": ["project"] },
              "context": {
                "properties": { "loading": { "const": "always" } },
                "required": ["loading"]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "kind": { "enum": ["skill", "command"] } },
            "required": ["kind"]
          },
          "then": { "required": ["content", "context"] }
        },
        {
          "if": { "properties": { "kind": { "const": "plugin" } }, "required": ["kind"] },
          "then": {
            "required": ["adapters", "adapter", "lastVerified"],
            "properties": {
              "adapters": { "const": ["claude"] },
              "content": false,
              "context": false
            }
          },
          "else": { "properties": { "adapters": false, "adapter": false, "lastVerified": false } }
        },
        {
          "if": {
            "properties": { "recommendedScope": { "const": "project" } },
            "required": ["recommendedScope"]
          },
          "then": { "properties": { "scopes": { "contains": { "const": "project" } } } }
        },
        {
          "if": {
            "properties": { "recommendedScope": { "const": "user" } },
            "required": ["recommendedScope"]
          },
          "then": { "properties": { "scopes": { "contains": { "const": "user" } } } }
        },
        { "if": { "required": ["content"] }, "then": { "required": ["license"] } },
        {
          "if": {
            "properties": {
              "content": { "properties": { "kind": { "const": "remote" } }, "required": ["kind"] }
            },
            "required": ["content"]
          },
          "then": {
            "required": ["context"],
            "properties": { "context": { "required": ["estimatedTokens"] } }
          }
        },
        {
          "if": {
            "properties": {
              "content": { "properties": { "kind": { "const": "bundled" } }, "required": ["kind"] }
            },
            "required": ["content"]
          },
          "then": { "properties": { "context": { "properties": { "estimatedTokens": false } } } }
        }
      ]
    },
    "context": {
      "type": "object",
      "required": ["loading"],
      "properties": {
        "loading": { "enum": ["always", "on-demand", "explicit", "none"] },
        "estimatedTokens": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "content": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "path"],
          "properties": {
            "kind": { "const": "bundled" },
            "path": { "type": "string", "pattern": "\\S" },
            "root": { "type": "string", "pattern": "\\S" },
            "upstream": { "type": "string", "pattern": "\\S" },
            "revision": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "url", "upstream"],
          "properties": {
            "kind": { "const": "remote" },
            "url": {
              "type": "string",
              "pattern": "^https://raw\\.githubusercontent\\.com/[^/]+/[^/]+/[0-9a-fA-F]{40}/.+$"
            },
            "upstream": { "type": "string", "pattern": "\\S" },
            "root": { "type": "string", "pattern": "\\S" },
            "overlay": { "type": "string", "pattern": "\\S" },
            "licensePath": { "type": "string", "pattern": "\\S" },
            "licenseTarget": { "type": "string", "pattern": "\\S" }
          },
          "additionalProperties": false
        }
      ]
    },
    "suggest": {
      "type": "object",
      "required": ["when", "reason"],
      "properties": {
        "when": {
          "type": "object",
          "properties": {
            "all": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 1,
              "uniqueItems": true
            },
            "any": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "additionalProperties": false,
          "anyOf": [{ "required": ["all"] }, { "required": ["any"] }]
        },
        "reason": { "type": "string", "pattern": "\\S" }
      },
      "additionalProperties": false
    },
    "requires": {
      "type": "object",
      "required": ["commands"],
      "properties": {
        "commands": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-zA-Z0-9._-]+$" },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "adapter": {
      "type": "object",
      "required": ["claude"],
      "properties": {
        "claude": {
          "type": "object",
          "required": ["pluginId", "marketplace"],
          "properties": {
            "pluginId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
            "marketplace": {
              "type": "object",
              "required": ["name", "repo"],
              "properties": {
                "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
                "repo": { "type": "string", "pattern": "^[^/]+/[^/]+$" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
